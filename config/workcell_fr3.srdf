<?xml version="1.0" ?>
<robot name="fr3" version="1.0.0">

    <group name="manipulator">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    <!--Groups kinematic plugins -->
    <kinematics_plugin_config filename="package://snp_blending/config/workcell_plugins_fr3.yaml"/>

    <!-- Contact manager plugins -->
    <contact_managers_plugin_config filename="package://snp_blending/config/workcell_plugins_fr3.yaml"/>

    <disable_collisions link1="platform" link2="floor" reason="Never"/>
    <disable_collisions link1="base_link" link2="floor" reason="Never"/>
    <disable_collisions link1="link1" link2="floor" reason="Never"/>
    <disable_collisions link1="link2" link2="floor" reason="Never"/>
    <disable_collisions link1="link3" link2="floor" reason="Never"/>
    <disable_collisions link1="link4" link2="floor" reason="Never"/>
    <disable_collisions link1="link5" link2="floor" reason="Never"/>
    <disable_collisions link1="link6" link2="floor" reason="Never"/>
    <disable_collisions link1="link7" link2="floor" reason="Never"/>

    <disable_collisions link1="platform" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="link7" reason="Adjacent"/>
    <disable_collisions link1="link7" link2="tool0" reason="Adjacent"/>
    
    <disable_collisions link1="link7" link2="camera_color_optical_frame" reason="Never"/>
    <disable_collisions link1="tool0" link2="camera_color_optical_frame" reason="Never"/>
    
    <disable_collisions link1="base_link" link2="cal_target_frame" reason="Never"/>
    <disable_collisions link1="base_link" link2="tool0" reason="Never"/>
    <disable_collisions link1="base_link" link2="link6" reason="Never"/>
    <disable_collisions link1="base_link" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Adjacent"/>

</robot>

<?xml version="1.0" ?>
<robot name="ur5e" version="1.0.0">

    <group name="manipulator">
        <chain base_link="base_link" tip_link="tool0"/>
    </group>

    <!--Groups kinematic plugins -->
    <kinematics_plugin_config filename="package://snp_blending/config/workcell_plugins_ur5e.yaml"/>

    <!-- Contact manager plugins -->
    <contact_managers_plugin_config filename="package://snp_blending/config/workcell_plugins_ur5e.yaml"/>

    <disable_collisions link1="platform" link2="floor" reason="Never"/>
    <disable_collisions link1="base_link" link2="floor" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="floor" reason="Never"/>
    <disable_collisions link1="upper_arm_link" link2="floor" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="floor" reason="Never"/>
    <disable_collisions link1="wrist_1_link" link2="floor" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="floor" reason="Never"/>
    <disable_collisions link1="wrist_3_link" link2="floor" reason="Never"/>

    <disable_collisions link1="platform" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="tool0" reason="Adjacent"/>
    
    <disable_collisions link1="wrist_2_link" link2="platform" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="platform" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="platform" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="platform" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="platform" link2="wrist_3_link" reason="Adjacent"/>


    <disable_collisions link1="wrist_3_link" link2="camera_color_optical_frame" reason="Never"/>
    <disable_collisions link1="tool0" link2="camera_color_optical_frame" reason="Never"/>
    
    <disable_collisions link1="base_link" link2="cal_target_frame" reason="Never"/>
    <disable_collisions link1="base_link" link2="tool0" reason="Never"/>
    <disable_collisions link1="base_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="wrist_1_link" reason="Adjacent"/>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="fr3" params="prefix">
    <!-- Franka 3 robot macro for SNP blending workcell -->
    
    <!-- Base link -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link0.dae"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link0.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0172 0.0004 0.0745" rpy="0 0 0"/>
        <mass value="2.3966"/>
        <inertia ixx="0.0090" ixy="0.0000" ixz="0.0020" iyy="0.0115" iyz="0.0000" izz="0.0085"/>
      </inertial>
    </link>
    
    <!-- Link 1 -->
    <link name="${prefix}link1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link1.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0000004128 -0.0181251324 -0.0386035970" rpy="0 0 0"/>
        <mass value="2.9274653454"/>
        <inertia ixx="0.023927316485107913" ixy="1.3317903455714081e-05" ixz="-0.00011404774918616684" iyy="0.0224821613275756" iyz="-0.0019950320628240115" izz="0.006350098258530016"/>
      </inertial>
    </link>
    
    <!-- Link 2 -->
    <link name="${prefix}link2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link2.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0031828864 -0.0743221644 0.0088146084" rpy="0 0 0"/>
        <mass value="2.9355370338"/>
        <inertia ixx="0.041938946257609425" ixy="0.00020257331521090626" ixz="0.004077784227179924" iyy="0.02514514885014724" iyz="-0.0042252158006570156" izz="0.06170214472888839"/>
      </inertial>
    </link>
    
    <!-- Link 3 -->
    <link name="${prefix}link3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link3.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0407015686 -0.0048200565 -0.0289730823" rpy="0 0 0"/>
        <mass value="2.2449013699"/>
        <inertia ixx="0.02410142547240885" ixy="0.002404694559042109" ixz="-0.002856269270114313" iyy="0.01974053266708178" iyz="-0.002104212683891874" izz="0.019044494482244823"/>
      </inertial>
    </link>
    
    <!-- Link 4 -->
    <link name="${prefix}link4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link4.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0459100965 0.0630492960 -0.0085187868" rpy="0 0 0"/>
        <mass value="2.6155955791"/>
        <inertia ixx="0.03452998321913202" ixy="0.01322552265982813" ixz="0.01015142998484113" iyy="0.028881621933049058" iyz="-0.0009762833870704552" izz="0.04125471171146641"/>
      </inertial>
    </link>
    
    <!-- Link 5 -->
    <link name="${prefix}link5">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link5.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0016039605 0.0292536262 -0.0972965990" rpy="0 0 0"/>
        <mass value="2.3271207594"/>
        <inertia ixx="0.051610278463662895" ixy="-0.005715173387783472" ixz="-0.0035673167625872135" iyy="0.04787713371481" iyz="0.010673985108535986" izz="0.016423625579357254"/>
      </inertial>
    </link>
    
    <!-- Link 6 -->
    <link name="${prefix}link6">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link6.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0597131221 -0.0410294666 -0.0101692726" rpy="0 0 0"/>
        <mass value="1.8170376524"/>
        <inertia ixx="0.005412333594383447" ixy="0.006193456360285834" ixz="0.0014219289306117652" iyy="0.014058329545509979" iyz="-0.0013140753741120031" izz="0.016080817924212554"/>
      </inertial>
    </link>
    
    <!-- Link 7 -->
    <link name="${prefix}link7">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/visual/link7.dae"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://snp_blending/urdf/fr3/collision/link7.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0045225817 0.0086261921 -0.0161633251" rpy="0 0 0"/>
        <mass value="0.6271432862"/>
        <inertia ixx="0.00021092389150104718" ixy="-2.433299114461931e-05" ixz="4.564480393778983e-05" iyy="0.00017718568002411474" iyz="8.744070223226438e-05" izz="5.993299114659971e-05"/>
      </inertial>
    </link>
    
    <!-- Tool0 link -->
    <link name="${prefix}tool0"/>
    
    <!-- Joint 1 base -> link1 -->
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0 0.333" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.7437" upper="2.7437" effort="87.0" velocity="2.62"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 2 link1 -> link2 -->
    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0 0 0" rpy="-1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.7837" upper="1.7837" effort="87.0" velocity="2.62"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 3 link2 -> link3 -->
    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="0 -0.316 0" rpy="1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.9007" upper="2.9007" effort="87.0" velocity="2.62"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 4 link3 -> link4 -->
    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0.0825 0 0" rpy="1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0421" upper="-0.1518" effort="87.0" velocity="2.62"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 5 link4 -> link5 -->
    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="-0.0825 0.384 0" rpy="-1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8065" upper="2.8065" effort="12.0" velocity="5.26"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 6 link5 -> link6 -->
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <origin xyz="0 0 0" rpy="1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.5445" upper="4.5169" effort="12.0" velocity="4.18"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 7 link6 -> link7 -->
    <joint name="${prefix}joint7" type="revolute">
      <parent link="${prefix}link6"/>
      <child link="${prefix}link7"/>
      <origin xyz="0.088 0 0" rpy="1.570796326794897 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0159" upper="3.0159" effort="12.0" velocity="5.26"/>
      <dynamics damping="0.003" friction="0.2"/>
    </joint>
    
    <!-- Joint 7 -> tool0 link7 -> tool0 -->
    <joint name="${prefix}joint7-tool0" type="fixed">
      <parent link="${prefix}link7"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0.107" rpy="0 0 0"/>
    </joint>
    
  </xacro:macro>
</robot>
